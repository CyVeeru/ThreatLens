# =====================================================================
# ThreatLens — environment configuration
# Copy to `.env` and edit.
# =====================================================================

# --------------------- Runtime ---------------------
# `production` switches off Vite dev middleware, serves the built bundle,
# and enables strict mode (see THREATLENS_STRICT below).
NODE_ENV=production

# HTTP port.
PORT=7099

# Listen address. Defaults to 127.0.0.1 — ThreatLens holds credentials, API
# keys and unreviewed intel, so it is not exposed to the local network unless
# you say so. Set 0.0.0.0 to serve other machines, and put a TLS-terminating
# reverse proxy in front of it when you do.
# THREATLENS_HOST=127.0.0.1

# --------------------- Storage paths ---------------------
# Runtime workspace database. Defaults to data/data.db (a legacy root data.db
# is honoured if present). Keep it inside the directory you back up or mount.
# THREATLENS_DB_PATH=data/data.db
# Provider-key ciphertext store. Defaults to data/secrets/threatlens-secrets.db.
# THREATLENS_SECRET_DB=data/secrets/threatlens-secrets.db
# Key-encryption key for secrets at rest. Defaults to a random key written to
# data/.threatlens-kek on first boot. Set explicitly for ephemeral containers.
# THREATLENS_KEK=

# --------------------- Production-strict mode ---------------------
# When 1, every AI / OSINT path refuses to silently fall back to mock
# output and surfaces HTTP 409 / 502 with a real provider error.
# When 0, mock fallbacks fire when no provider is configured.
# Defaults to 1 when NODE_ENV=production, 0 otherwise. Override explicitly:
THREATLENS_STRICT=1

# --------------------- Live AI master switch ---------------------
# When 0, every live AI call is short-circuited regardless of per-provider
# keys. Useful for local development without API quota. Default 1.
THREATLENS_AI_LIVE=1

# --------------------- Authentication ---------------------
# TOTP multi-factor is opt-in. Set to 1 to require every account to enroll MFA
# before the workspace unlocks (recommended for shared or exposed deployments).
# Accounts that enrolled voluntarily are always asked for a code at login.
# THREATLENS_REQUIRE_MFA=1

# On first boot ThreatLens generates a random password for each first-run
# account and shows it on the sign-in page, but only while those accounts still
# use it and only to clients on the loopback interface. Set to 1 to show the
# hint to remote clients too (e.g. when you run ThreatLens in a container and
# reach it from your desktop). It goes quiet the moment they are changed.
# THREATLENS_SHOW_SEED_CREDENTIALS=1

# --------------------- Local AI gateway ---------------------
# AI provider base URLs must be HTTPS on the default port, and may not target
# loopback or private address space. Set this to 1 to allow an
# http://localhost:<port> base URL for a local OpenAI-compatible gateway
# (LM Studio, llama.cpp, LiteLLM, Ollama's OpenAI shim, etc.).
# THREATLENS_ALLOW_LOCAL_AI=1

# --------------------- CVE enrichment ---------------------
# NVD's public API allows ~5 requests / 30s without a key. This caps how many
# CVEs are sent to NVD per background tick; EPSS and KEV are bulk and unbounded.
# THREATLENS_NVD_PER_TICK=4

# --------------------- Hosting hints (optional) ---------------------
# Reserved for future multi-host orchestration. Leave unset.
# HOSTING_MODE=

# =====================================================================
# AI PROVIDER KEYS ARE NOT READ FROM ENV
# ---------------------------------------------------------------------
# ThreatLens stores AI provider keys in the local secret database and
# references them from the ai_providers table. Configure them at /#/ai-setup
# after first login. Keys are never bundled in the public seed data.
# =====================================================================
